{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrgd:cog:ri-imu-evidence-binding:v0.1-candidate",
  "$comment": "Explicit read-only association of a Console normalized IMU record with RI's exact stored presentation. Neither source attestation nor permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binding_ref", "ri_observation_id", "ri_payload_sha256_hex", "console_sample_sha256_hex", "source_id", "sensor_id", "frame_id", "source_session_id", "sample_sequence", "console_host_receipt_monotonic_ns", "ri_host_receipt_monotonic_ns", "ri_boot_id", "ri_clock_domain_id", "c1_local_evidence_ref", "byte_relation", "clock_relation", "freshness", "source_authentication", "sensor_calibration", "robot_binding_verified", "decision_eligible", "can_generate_goal", "may_actuate", "grants_authority", "life_id", "chronon_id"],
  "properties": {
    "schema_version": {"const": "cog_ri_imu_evidence_binding_v0.1-candidate"},
    "binding_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ri_observation_id": {"type": "string", "pattern": "^obs_[0-9a-f]{32}$"},
    "ri_payload_sha256_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "console_sample_sha256_hex": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "sensor_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "frame_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_session_id": {"type": "string", "pattern": "^[a-fA-F0-9]{32}$"},
    "sample_sequence": {"type": "integer", "minimum": 0},
    "console_host_receipt_monotonic_ns": {"type": "integer", "minimum": 1},
    "ri_host_receipt_monotonic_ns": {"type": "integer", "minimum": 0},
    "ri_boot_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "ri_clock_domain_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "c1_local_evidence_ref": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "byte_relation": {"const": "EXACT_STORED_NORMALIZED_COPY"},
    "clock_relation": {"enum": ["HOST_SAME_BOOT_ASSERTED", "NOT_ESTABLISHED"]},
    "freshness": {"enum": ["FRESH", "STALE", "UNKNOWN"]},
    "source_authentication": {"const": "NOT_VERIFIED"},
    "sensor_calibration": {"const": "UNVERIFIED"},
    "robot_binding_verified": {"const": false},
    "decision_eligible": {"const": false},
    "can_generate_goal": {"const": false},
    "may_actuate": {"const": false},
    "grants_authority": {"const": false},
    "life_id": {"type": "null"},
    "chronon_id": {"type": "null"}
  }
}
