{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:openrgd:cog:core-b-local:v1-candidate",
  "$comment": "Local typed companions only; not Core ABI extensions, no advisory negotiation or history.",
  "$defs": {
    "TransitionDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transition_ref", "task_ref", "reason_code", "verification", "chronon_id", "life_id"],
      "properties": {
        "schema_version": {"const": "cog_core_b_transition_detail_v1-candidate"},
        "transition_ref": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "task_ref": {"type": "string", "minLength": 1, "maxLength": 256},
        "reason_code": {"type": "string", "minLength": 1, "maxLength": 256},
        "verification": {"const": "UNVERIFIED"},
        "chronon_id": {"type": "null"},
        "life_id": {"type": "null"}
      }
    },
    "Outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "code", "verification", "evidence_refs", "task_generation", "grants_authority"],
      "properties": {
        "schema_version": {"const": "cog_core_b_outcome_v1-candidate"},
        "code": {"enum": ["ANALYSIS_COMPLETE", "INSUFFICIENT_EVIDENCE", "ABSTAIN"]},
        "verification": {"const": "UNVERIFIED"},
        "evidence_refs": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
        "task_generation": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "grants_authority": {"const": false}
      }
    },
    "TaskDetail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "goal_id", "goal_revision", "task_ref", "source_cue", "created_monotonic_ns", "deadline_monotonic_ns", "success_condition", "stop_conditions", "evidence_quality", "verification", "life_id", "chronon_id", "grants_authority"],
      "properties": {
        "schema_version": {"const": "cog_core_b_task_detail_v1-candidate"},
        "goal_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "goal_revision": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "task_ref": {"const": "cog.task.v1:imu-uncertainty"},
        "source_cue": {"type": "object", "$comment": "Additionally validated by the genuine existing C1 AttentionCue validator and digest, before wrapping."},
        "created_monotonic_ns": {"type": "integer", "minimum": 0},
        "deadline_monotonic_ns": {"type": "integer", "minimum": 0},
        "success_condition": {"const": "ANALYSIS_REPORTED_NOT_HYPOTHESIS_CONFIRMED"},
        "stop_conditions": {"const": ["ORIGINAL_EVIDENCE_EXPIRED", "BUDGET_EXHAUSTED", "CONTEXT_CHANGED"]},
        "evidence_quality": {"const": "DECLARED_ONLY"},
        "verification": {"const": "UNVERIFIED"},
        "life_id": {"type": "null"},
        "chronon_id": {"type": "null"},
        "grants_authority": {"const": false}
      }
    }
  }
}
