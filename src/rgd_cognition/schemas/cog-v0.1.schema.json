s", "queue_wait_ms", "compute_ms", "memory_status", "chronon_link_status", "privacy_scope", "may_actuate", "evidence_level", "receipt_clock_domain", "receipt_monotonic_ns"]},
    "TurnResult": {"type": "object", "additionalProperties": false, "properties": {"schema_version": {"const": "cog_turn_result_v0.1-candidate"}, "proposal": {"$ref": "#/$defs/CognitiveProposal"}, "trace": {"$ref": "#/$defs/CognitiveTrace"}}, "required": ["schema_version", "proposal", "trace"]}
  }
