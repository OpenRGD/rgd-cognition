# Candidate 01C: fixed synthetic lab only. No [Install], socket activation or restart.
[Unit]
Description=OpenRGD Cognition synthetic session laboratory
Documentation=https://github.com/OpenRGD/rgd-cognition/issues/12
ConditionPathExists=/opt/rgd-cog/current/manifest.json

[Service]
Type=exec
DynamicUser=yes
User=rgd-cog-lab
Group=rgd-cog-lab
SupplementaryGroups=
WorkingDirectory=/opt/rgd-cog/current
ExecStart=/opt/rgd-cog/current/venv/bin/python -I -B -m rgd_cognition.service_lab run --enable-synthetic-lab --core-b-checkout /opt/rgd-cog/current/core-b --runtime-dir /run/rgd-cog-lab --duration-seconds 60
Restart=no
RuntimeMaxSec=75s
TimeoutStartSec=10s
TimeoutStopSec=5s
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes
OOMPolicy=stop
RuntimeDirectory=rgd-cog-lab
RuntimeDirectoryMode=0700
UMask=0077
Environment=LANG=C.UTF-8 LC_ALL=C.UTF-8 PYTHONUNBUFFERED=1
StandardInput=null
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rgd-cog-lab
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
DevicePolicy=closed
PrivateNetwork=yes
PrivateTmp=yes
PrivateMounts=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictAddressFamilies=none
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @privileged socket socketpair
SystemCallErrorNumber=EPERM
InaccessiblePaths=-/run/docker.sock -/run/containerd -/run/rgd-agent -/run/rgd-gateway -/run/rgd-cog-deny.sock -/dev/shm
MemoryAccounting=yes
MemoryHigh=384M
MemoryMax=512M
MemorySwapMax=0
CPUAccounting=yes
CPUQuota=100%
TasksAccounting=yes
TasksMax=16
LimitNOFILE=128
LimitCORE=0
